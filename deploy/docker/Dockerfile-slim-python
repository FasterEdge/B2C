ARG GO_VERSION=1.26.11
FROM ghcr.io/lf-edge/ekuiper/base:$GO_VERSION-debian AS builder
ENV GOTOOLCHAIN=auto

COPY . /go/kuiper

WORKDIR /go/kuiper

# .dockerignore 排除了 .git, 容器里 git describe 必然失败, 版本号由外部传入;
# 否则 sed 会把 version 改成空字符串, setuptools 直接拒绝构建 wheel。
ARG B2C_VERSION=0.0.0
RUN sed -i -r "s|([ \t]*version=).*|\1'${B2C_VERSION}',|1" sdk/python/setup.py
RUN cat sdk/python/setup.py
RUN make build_with_edgex_and_script

FROM python:3.12-bookworm AS python-builder

COPY --from=builder /go/kuiper/sdk/python /sdk/python
ARG DEBIAN_FRONTEND="noninteractive"

# Install build dependencies for pynng (including nng and mbedtls)
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        wget cmake libffi-dev git \
        build-essential gcc g++ libc-dev \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/* /tmp/* /var/tmp/* \
    && python3 -m ensurepip --upgrade \
    && python3 -m pip install --no-cache-dir setuptools

WORKDIR /sdk/python
RUN cat setup.py
RUN pip wheel .

FROM python:3.12-slim-bookworm

COPY --from=python-builder /sdk/python /sdk/python
WORKDIR /sdk/python
RUN pip install *.whl

COPY --from=builder /go/kuiper/_build/b2c-* /b2c/
WORKDIR /b2c
RUN rm -rf /sdk/python
COPY ./deploy/docker/docker-entrypoint.sh /usr/bin/docker-entrypoint.sh

ENV MAINTAINER="b2c"
ENV KUIPER_HOME="/b2c"
ENV KUIPER__BASIC__CONSOLELOG=true

VOLUME ["/b2c/etc", "/b2c/data", "/b2c/plugins", "/b2c/log"]
EXPOSE 9081 20498

ENTRYPOINT ["/usr/bin/docker-entrypoint.sh"]

CMD ["./bin/b2cd"]
