FROM golang:1.26.11-alpine AS builder
# go.work 与各 go.mod 要求 go 1.27.x, 而镜像自带的工具链是 1.26.11。
# 放开 GOTOOLCHAIN 让 go 命令按需下载匹配的工具链, 否则直接报版本不足。
ENV GOTOOLCHAIN=auto

COPY . /go/kuiper

WORKDIR /go/kuiper/tools/kubernetes

RUN go build -o b2c-kubernetes-tool main.go

FROM alpine:3.20.0

WORKDIR /b2c-kubernetes-tool

RUN mkdir -p log

COPY --from=builder /go/kuiper/tools/kubernetes/b2c-kubernetes-tool .
COPY --from=builder /go/kuiper/tools/kubernetes/etc etc
COPY --from=builder /go/kuiper/tools/kubernetes/sample sample

CMD ["./b2c-kubernetes-tool", "etc/cf.yaml"]
